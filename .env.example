# Gmail address that sends the digest
GMAIL_USER=you@gmail.com

# 16-character App Password from Google Account > Security > App passwords
# (NOT your regular Gmail password)
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Where to deliver the digest — defaults to GMAIL_USER if unset
# Comma-separate for multiple recipients: user@example.com,other@example.com
MAIL_TO=you@gmail.com

# Optional: free Gemini API key from aistudio.google.com
# When set, the top jobs are re-ranked with a one-line "why it fits" note.
GEMINI_API_KEY=

# Gemini model to use (defaults to gemini-2.5-flash if unset)
GEMINI_MODEL=gemini-2.5-flash

# Set to 1 to drop/downrank jobs that explicitly exclude India/APAC
# e.g. "US only", "EU only". Off by default.
LOCATION_FILTER=0
